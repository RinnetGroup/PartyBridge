{
  "name": "partybridge",
  "version": "0.1.0",
  "private": true,
  "productName": "PartyBridge",
  "description": "An unofficial desktop client for PlayStation parties, voice and friends",
  "author": "PartyBridge contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "start": "node scripts/start-desktop.mjs",
    "start:web": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:build": "node scripts/build-release.mjs --dir",
    "release:build": "node scripts/build-release.mjs",
    "release:source": "node scripts/source-archive.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "opusscript": "0.1.1",
    "werift": "0.25.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RinnetGroup/PartyBridge.git"
  },
  "homepage": "https://github.com/RinnetGroup/PartyBridge#readme",
  "bugs": {
    "url": "https://github.com/RinnetGroup/PartyBridge/issues"
  }
}
